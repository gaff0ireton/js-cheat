---
interface Props {
  title: string;
  command: string;
  description: string;
  category: string;
  highlightedCode: string;
}

import Command from './Command.tsx';

const { title, command, description, category, highlightedCode } = Astro.props;
---

<article class="card" data-category={category}>
  <header class="card__header">
    <h3>{title}</h3>
  </header>
  <div class="card__body">
    <p>{description}</p>
    <Command command={command} highlightedCode={highlightedCode} client:load />
  </div>
</article>
